"Keybinds.Toggle Profiler.DisplayName": Переключить оверлей (F6)
"Keybinds.Toggle Hardware Cursor.DisplayName": Переключить аппаратный курсор (F7)
"Keybinds.Toggle World Preload.DisplayName": Переключить предзагрузку мира (F8)

Configs: {
	OptimizerConfig: {
		DisplayName: Оптимизатор движка

		ShowOverlayOnStart: {
			Label: Показывать оверлей при входе
			Tooltip: Оверлей с FPS и таймингами кадра. Включается/выключается клавишей F6.
		}

		SaveReportOnWorldExit: {
			Label: Сохранять отчёт при выходе из мира
			Tooltip: Пишет profile-*.csv с итоговыми avg/p95/max при выходе из мира.
		}

		ReduceGcPauses: {
			Label: Уменьшать паузы GC
			Tooltip: Режим SustainedLowLatency в мире и минимум потоков пула: меньше и короче паузы сборщика мусора.
		}

		BoostProcessPriority: {
			Label: Повышать приоритет процесса
			Tooltip: На время игры в мире приоритет процесса ставится AboveNormal: браузер, Discord и другой фон реже отбирают у игры процессор. Частоту турбобуста мод поменять не может (это ОС/BIOS), но убрать вытеснение — может. После выхода из мира возвращается Normal.
		}

		DeferAutosaveDuringBoss: {
			Label: Откладывать автосейв во время боя
			Tooltip: Автосейв переносится на момент после боя с боссом. Таймер продолжает идти, предохранитель — 10 минут.
		}

		BossPerfMode: {
			Label: Режим босс-боёв (макс. FPS)
			Tooltip: В бою с боссом (радиус 125 тайлов) отключает самые дорогие эффекты: дым Calamity (хук с ранним выходом), heat distortion и storm effects, а также приостанавливает рост травы/лиан в мире (незаметно; в мультиплеере не влияет — мир обновляет сервер). Через 2 секунды после боя всё возвращается. Телеметрия помечает такие кадры флагом boss_perf.
		}

		ParallelGore: {
			Label: Параллельный gore
			Tooltip: Обновляет ванильный gore на пуле потоков. Модовый gore, капли, dust-типы и светящийся gore остаются на главном потоке.
		}

		ParallelRain: {
			Label: Параллельный дождь (эксперимент)
			Tooltip: Обновляет капли дождя параллельно до отрисовки. По умолчанию выключено: HighFPSSupport уже хукает Rain.Update.
		}

		PreloadWorld: {
			Label: Предзагрузка мира
			Tooltip: Пересчитывает фреймы всех секций сразу после входа в мир (одиночная игра и клиент мультиплеера; на сервере не работает). Убирает рывки при ходьбе по новым местам. В мультиплеере недогруженные секции добираются повторными проходами.
		}

		PreloadBudgetMs: {
			Label: Бюджет предзагрузки, мс/кадр
			Tooltip: Верхняя граница миллисекунд на кадр для предзагрузки. Фактический срез меньше: мод вычитает уже потраченное время update+draw и оставляет 1 мс запаса. 0 — весь мир сразу (окно замрёт на несколько секунд).
		}

		SmoothHardwareCursor: {
			Label: Аппаратный курсор
			Tooltip: Рисует ванильный курсор в render target и отдаёт его Windows как OS-курсор. Если курсор вдруг пропал — нажмите F7: мод сразу вернёт обычный курсор. Выключите, если используете другой курсорный мод.
		}
	}
}
