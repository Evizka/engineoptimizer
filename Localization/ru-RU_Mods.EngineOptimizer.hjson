"Keybinds.Toggle Profiler.DisplayName": Переключить оверлей (F6)

Configs: {
	OptimizerConfig: {
		DisplayName: Оптимизатор движка

		ShowOverlayOnStart: {
			Label: Показывать оверлей при входе
			Tooltip: Оверлей с FPS и таймингами кадра. Включается/выключается клавишей F6.
		}

		SaveReportOnWorldExit: {
			Label: Сохранять отчёт при выходе из мира
			Tooltip: Пишет profile-*.csv с итоговыми avg/p95/max при выходе из мира.
		}

		ReduceGcPauses: {
			Label: Уменьшать паузы GC
			Tooltip: Режим SustainedLowLatency в мире и минимум потоков пула: меньше и короче паузы сборщика мусора.
		}

		DeferAutosaveDuringBoss: {
			Label: Откладывать автосейв во время боя
			Tooltip: Автосейв переносится на момент после боя с боссом. Таймер продолжает идти, предохранитель — 10 минут.
		}

		ParallelGore: {
			Label: Параллельный gore
			Tooltip: Обновляет ванильный gore на пуле потоков. Модовый gore, капли, dust-типы и светящийся gore остаются на главном потоке.
		}

		ParallelRain: {
			Label: Параллельный дождь (эксперимент)
			Tooltip: Обновляет капли дождя параллельно до отрисовки. По умолчанию выключено: HighFPSSupport уже хукает Rain.Update.
		}

		PreloadWorld: {
			Label: Предзагрузка мира
			Tooltip: Пересчитывает фреймы всех секций сразу после входа в мир (только одиночная игра). Убирает рывки при ходьбе по новым местам.
		}

		PreloadBudgetMs: {
			Label: Бюджет предзагрузки, мс/кадр
			Tooltip: Верхняя граница миллисекунд на кадр для предзагрузки. Фактический срез меньше: мод вычитает уже потраченное время update+draw и оставляет 1 мс запаса. 0 — весь мир сразу (окно замрёт на несколько секунд).
		}

		SmoothHardwareCursor: {
			Label: Аппаратный курсор
			Tooltip: Рисует ванильный курсор в render target и отдаёт его Windows как OS-курсор. Выключите, если используете другой курсорный мод.
		}
	}
}
