"Keybinds.Toggle Profiler.DisplayName": Mods.EngineOptimizer.Keybinds.Toggle Profiler.DisplayName
"Keybinds.Toggle World Preload.DisplayName": Toggle world preload (F8)
"Keybinds.Cycle Preset.DisplayName": Cycle optimization preset (F9)
"ConfigEnums.OptimizerPreset.Balanced": Balanced
"ConfigEnums.OptimizerPreset.MaxFps": Max FPS
"ConfigEnums.OptimizerPreset.DiagnosticsOnly": Diagnostics only

Configs: {
	OptimizerConfig: {
		Preset: {
			Label: Optimization preset
			Tooltip: "One global switch for all optimizations at once. Balanced - as configured below; Max FPS - everything on (boss mode, parallel gore, preload with a 5 ms+ budget, GC, process priority); Diagnostics only - all engine patches off, the mod only measures and writes reports. Cycle in game with F9."
		}

		DisplayName: Optimizer Config

		ShowOverlayOnStart: {
			Label: Show Overlay On Start
			Tooltip: ""
		}

		SaveReportOnWorldExit: {
			Label: Save Report On World Exit
			Tooltip: ""
		}

		ReduceGcPauses: {
			Label: Reduce Gc Pauses
			Tooltip: ""
		}

		BoostProcessPriority: {
			Label: Boost Process Priority
			Tooltip: While in a world the process priority is raised to AboveNormal: the browser, Discord and other background apps steal CPU from the game less often. The mod cannot change the turbo boost clock (that is OS/BIOS territory), but removing contention it can. Restored to Normal after leaving the world.
		}

		DeferAutosaveDuringBoss: {
			Label: Defer Autosave During Boss
			Tooltip: Autosave is postponed until after the boss fight. The timer keeps counting; failsafe is 10 minutes.
		}

		BossPerfMode: {
			Label: Boss fight perf mode (max FPS)
			Tooltip: During a boss fight (125-tile radius) disables the most expensive visual effects: Calamity smoke (early-exit hook), heat distortion and storm effects. Everything is restored 2 seconds after the fight. Telemetry marks those frames with the boss_perf flag.
		}

		ParallelGore: {
			Label: Parallel Gore
			Tooltip: ""
		}

		ParallelRain: {
			Label: Parallel Rain
			Tooltip: ""
		}

		PreloadWorld: {
			Label: Preload World
			Tooltip: Recalculates the frame data of all world sections right after entering the world (single player and multiplayer client; not on a listen server or dedicated server). Removes hitches when walking into new areas. In multiplayer, sections that have not arrived from the server yet are picked up by periodic re-scans. Toggle on the fly with F8. In multiplayer the banner is not shown: up to 3 quiet re-scans while the server keeps sending sections.
		}

		PreloadBudgetMs: {
			Label: Preload Budget Ms
			Tooltip: ""
		}


	}
}
